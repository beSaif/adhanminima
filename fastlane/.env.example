# Copy to fastlane/.env (gitignored) and fill in. No secrets here: the .p8 and
# Play JSON key stay in ~/.adhaan-secrets/, these are only pointers and IDs.

# App Store Connect API key (Users and Access -> Integrations -> App Store Connect API)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.adhaan-secrets/AuthKey_XXXXXXXXXX.p8

# Apple Developer team that owns Adhaan
APPLE_TEAM_ID=THGBZFL626

# Google Play service account key
PLAY_JSON_KEY=~/.adhaan-secrets/play.json
